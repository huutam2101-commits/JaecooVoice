<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_dark"
    android:orientation="vertical"
    android:padding="16dp"
    tools:context=".DebugScreen">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Màn hình Debug - Jaecoo Voice"
        android:textColor="@color/text_primary"
        android:textSize="20sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/edtCommand"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@color/surface_dark"
        android:hint="Nhập câu lệnh test (vd: mở cửa sổ trời)"
        android:padding="12dp"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_secondary"
        android:textSize="16sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnTest"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:backgroundTint="@color/accent_blue"
            android:text="Test Lệnh" />

        <Button
            android:id="@+id/btnTestAll"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:backgroundTint="@color/accent_yellow"
            android:text="Test 13 Lệnh Mẫu"
            android:textColor="@color/background_dark" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnDumpUi"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:backgroundTint="@color/surface_dark"
            android:text="Dump Cây UI" />

        <Button
            android:id="@+id/btnOpenVr"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:backgroundTint="@color/surface_dark"
            android:text="Mở VRControl" />

        <Button
            android:id="@+id/btnA11y"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:backgroundTint="@color/surface_dark"
            android:text="Bật A11y" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Test Tọa độ Bottom Bar (1440x1920):"
        android:textColor="@color/text_primary"
        android:textSize="13sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnCoord1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:backgroundTint="@color/surface_dark"
            android:padding="0dp"
            android:text="Climate (725,1830)"
            android:textSize="10sp" />

        <Button
            android:id="@+id/btnCoord2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:backgroundTint="@color/surface_dark"
            android:padding="0dp"
            android:text="Vehicle (287,1830)"
            android:textSize="10sp" />

        <Button
            android:id="@+id/btnCoord3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:backgroundTint="@color/surface_dark"
            android:padding="0dp"
            android:text="Temp L (475,1830)"
            android:textSize="10sp" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Test Điều Khiển HVAC Panel:"
        android:textColor="@color/text_primary"
        android:textSize="13sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnHvacPower"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:backgroundTint="@color/accent_blue"
            android:padding="0dp"
            android:text="Power"
            android:textSize="10sp" />

        <Button
            android:id="@+id/btnHvacAc"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:backgroundTint="@color/surface_dark"
            android:padding="0dp"
            android:text="AC"
            android:textSize="10sp" />

        <Button
            android:id="@+id/btnHvacFanUp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:backgroundTint="@color/surface_dark"
            android:padding="0dp"
            android:text="Quạt +"
            android:textSize="10sp" />

        <Button
            android:id="@+id/btnHvacFanDown"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:backgroundTint="@color/surface_dark"
            android:padding="0dp"
            android:text="Quạt -"
            android:textSize="10sp" />

        <Button
            android:id="@+id/btnHvacTempUp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:backgroundTint="@color/surface_dark"
            android:padding="0dp"
            android:text="Nhiệt +"
            android:textSize="10sp" />

        <Button
            android:id="@+id/btnHvacTempDown"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:backgroundTint="@color/surface_dark"
            android:padding="0dp"
            android:text="Nhiệt -"
            android:textSize="10sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnHvacAuto"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:backgroundTint="@color/surface_dark"
            android:padding="0dp"
            android:text="Auto"
            android:textSize="10sp" />

        <Button
            android:id="@+id/btnHvacRecirc"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1.5"
            android:backgroundTint="@color/accent_yellow"
            android:padding="0dp"
            android:text="Gió Trong/Ngoài"
            android:textColor="@color/background_dark"
            android:textSize="10sp" />

        <Button
            android:id="@+id/btnHvacIon"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:backgroundTint="@color/surface_dark"
            android:padding="0dp"
            android:text="ION"
            android:textSize="10sp" />

        <Button
            android:id="@+id/btnHvacSync"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:backgroundTint="@color/surface_dark"
            android:padding="0dp"
            android:text="Sync"
            android:textSize="10sp" />

        <Button
            android:id="@+id/btnHvacState"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:backgroundTint="@color/surface_dark"
            android:padding="0dp"
            android:text="State"
            android:textSize="10sp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:layout_weight="1"
        android:background="@color/surface_dark"
        android:padding="12dp">

        <TextView
            android:id="@+id/tvDebugLog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:text="Sẵn sàng log..."
            android:textColor="@color/accent_green"
            android:textSize="12sp" />
    </ScrollView>

</LinearLayout>
